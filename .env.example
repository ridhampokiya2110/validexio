# Validexio Environment Variables
# Copy this to .env.local and fill in your values

# ============================================
# NEXT.JS
# ============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here-generate-with-openssl-rand-base64-32

# ============================================
# SUPABASE
# ============================================
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database (Supabase PostgreSQL Direct Connection)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# For Prisma migrations - use direct connection
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ============================================
# GOOGLE GEMINI AI
# ============================================
GOOGLE_GEMINI_API_KEY=your-gemini-api-key

# ============================================
# GOOGLE OAUTH
# ============================================
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ============================================
# GITHUB OAUTH
# ============================================
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ============================================
# STRIPE
# ============================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Stripe Product/Price IDs
STRIPE_PRO_PRICE_ID=price_your-pro-plan-price-id
STRIPE_TEAM_PRICE_ID=price_your-team-plan-price-id

# ============================================
# RESEND (EMAIL)
# ============================================
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@validexio.com
RESEND_FROM_NAME=Validexio

# ============================================
# UPSTASH REDIS (Rate Limiting & Caching)
# ============================================
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ============================================
# BULLMQ REDIS (Background Worker Queue)
# ============================================
# Note: If you were on Railway, Railway injected these automatically. 
# On Render/Vercel, you must provide them manually. You can get these from your Upstash Dashboard (Node.js standard connection) or by creating a free Redis instance on Render.

REDIS_PORT=6379
UPSTASH_REDIS_REST_URL="https://calm-walleye-142743.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAi2XAAIgcDEzNTYxMjM0ZmZlNGM0ZmY4YjI5N2RiYWRiYzY0Njg4NQ"

# ============================================
# SENTRY (Error Monitoring)
# ============================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=validexio

# ============================================
# POSTHOG (Analytics)
# ============================================
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================
# APP CONFIG
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Validexio
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
