// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTH & USER MODELS
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  provider      String?   @default("email")
  role          UserRole  @default(USER)
  tier          UserTier  @default(FREE)

  phone      String?
  profession String?
  bio        String?
  company    String?
  website    String?
  location   String?

  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String? 
  backupCodes      String[] 
  isBanned         Boolean  @default(false)

  // Lemon Squeezy Billing
  lemonSqueezyCustomerId     String? @unique
  lemonSqueezySubscriptionId String? @unique

  // Razorpay Billing
  razorpayCustomerId         String? @unique
  
  availableCredits           Int     @default(0)
  totalSpent                 Float   @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  accounts           Account[]
  sessions           Session[]
  loginHistory       LoginHistory[]
  auditLogs          AuditLog[]
  mfaConfig          MFAConfig?
  ideas              Idea[]
  validationSessions ValidationSession[]
  consents           UserConsent[]
  supportTickets     SupportTicket[]
  affiliateProfile   AffiliateProfile?
  couponUsages       CouponUsage[]
  payoutRequests     PayoutRequest[]
  notifications      Notification[]

  @@index([email])
  @@map("users")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // "PLAN_BOUGHT", "SECURITY_UPGRADE", "AFFILIATE_CODE", "AFFILIATE_SALE", "PAYOUT", "SUPPORT", "SYSTEM"
  title       String
  description String
  link        String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  deviceName String?
  deviceType String?
  browser    String?
  os         String?
  ipAddress  String?
  location   String?
  isCurrent  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model MFAConfig {
  id        String   @id @default(cuid())
  userId    String   @unique
  secret    String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_configs")
}

// ============================================
// SECURITY & AUDIT MODELS
// ============================================

model LoginHistory {
  id         String   @id @default(cuid())
  userId     String
  ipAddress  String?
  userAgent  String?
  browser    String?
  os         String?
  device     String?
  location   String?
  success    Boolean  @default(true)
  failReason String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("login_history")
}

model AuditLog {
  id         String        @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  severity   AuditSeverity @default(INFO)
  createdAt  DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// BUSINESS LOGIC (CORE APP)
// ============================================

model Idea {
  id           String     @id @default(cuid())
  userId       String
  title        String
  description  String     @db.Text
  industry     String
  targetMarket String?
  location     String?
  pricingModel String?
  stage        IdeaStage  @default(IDEA)
  status       IdeaStatus @default(PENDING)
  isLite       Boolean    @default(false)

  documentContext Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports ValidationReport[]

  @@index([userId])
  @@index([status])
  @@map("ideas")
}

model ValidationReport {
  id     String @id @default(cuid())
  ideaId String
  userId String

  validationScore   Int 
  marketOpportunity Int 
  productMarketFit  Int 
  riskScore         Int 

  marketAnalysis        Json 
  swotAnalysis          Json 
  competitors           Json 
  customerPersonas      Json 
  revenuePotential      Json 
  riskAnalysis          Json 
  pricingRecommendation Json 
  growthOpportunities   Json 
  acquisitionStrategy   Json 
  actionPlan            Json 
  launchPlatforms       Json?
  mvpPrioritization     Json?
  complianceCheck       Json?

  uiMockupDescriptions Json? 
  uiMockupImages       Json? 
  landingPageCopy      Json? 
  salesFunnel          Json? 
  codeBoilerplate      Json? 

  processingTime Int? 
  geminiModel    String? 
  tokensUsed     Int?
  isLite         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  idea  Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  leads Lead[]

  @@index([ideaId])
  @@index([userId])
  @@map("validation_reports")
}

model Lead {
  id             String     @id @default(cuid())
  reportId       String
  name           String?
  company        String?
  title          String?
  email          String?
  linkedin       String?
  website        String?
  relevanceScore Int 
  notes          String?    @db.Text
  status         LeadStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report ValidationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("leads")
}

model ValidationSession {
  id           String           @id @default(uuid())
  ipAddress    String
  status       ValidationStatus @default(PENDING)
  industry     IndustryType
  businessIdea String           @db.VarChar(1000)
  targetScope  String?          @db.VarChar(50) 
  targetCountry String?         @db.VarChar(100)
  targetState  String?          @db.VarChar(100)
  targetCity   String?          @db.VarChar(100)
  pricingModel PricingModelType
  jobId        String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  viabilityScore Int?
  antiRoadmap    Json?

  wtpScore      Int?
  unitEconomics Json?

  mockups         Json?
  b2bLeads        Json?
  financialModel  Json?
  codeBoilerplate Json?

  businessSections Json?
  executionAssets  Json?
  marketingAssets  Json?
  localMarketOverview   Json?
  opportunityComparison Json?

  uiMockups    String[] 
  codeAssetKey String? 

  isUnlocked   Boolean       @default(false)
  unlockedTier UnlockedTier?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("validation_sessions")
}

model SupportTicket {
  id       String         @id @default(uuid())
  userId   String
  category TicketCategory
  subject  String         @db.VarChar(150)
  message  String         @db.Text
  status   TicketStatus   @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

// ============================================
// PARTNERS & AFFILIATES
// ============================================

model AffiliateProfile {
  id             String  @id @default(uuid())
  userId         String  @unique
  couponCode     String  @unique @db.VarChar(10)
  payoutEmail    String
  upiId          String?
  trafficSource  String?
  pendingBalance Int     @default(0) 
  totalEarned    Int     @default(0) 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("affiliate_profiles")
}

model CouponUsage {
  id         String   @id @default(uuid())
  userId     String
  couponCode String
  usedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, couponCode])
  @@map("coupon_usages")
}

model PayoutRequest {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  upiId     String
  status    PayoutStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payout_requests")
}

// ============================================
// LEGAL & MARKETING
// ============================================

model PromoCode {
  id                 String   @id @default(uuid())
  code               String   @unique
  discountPercentage Int
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("promo_codes")
}

model CompetitorMatrix {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                 String   @unique
  name                 String
  basePrice            String
  dataSourceType       String
  reportFormatStyle    String
  primaryStrength      String
  fatalTradeoff        String
  verifiableSourcesScore Int
  hasLiveSources       Boolean  @default(false)
  hasPivotLogic        Boolean  @default(false)
  hasNextjsBoilerplate Boolean  @default(false)
  hasAwsBlueprints     Boolean  @default(false)
  hasApolloLeads       Boolean  @default(false)
  specificAttackVector String   @db.Text
  createdAt            DateTime @default(dbgenerated("TIMEZONE('utc'::text, NOW())")) @db.Timestamptz

  @@map("competitor_matrices")
}

model FreeToolLead {
  id                   String   @id @default(uuid())
  email                String   @unique
  saasIdea             String   @db.Text
  generatedCodeSnippet String?  @db.Text
  sourceUrl            String?
  createdAt            DateTime @default(now())

  @@map("free_tool_leads")
}

model LegalDocument {
  id          String       @id @default(uuid())
  type        LegalDocType
  version     String
  content     String       @db.Text
  isActive    Boolean      @default(false)
  publishedAt DateTime     @default(now())

  consents UserConsent[]

  @@index([type, isActive])
  @@map("legal_documents")
}

model UserConsent {
  id         String   @id @default(uuid())
  userId     String
  documentId String
  ipAddress  String
  agreedAt   DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("user_consents")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  USER
  ADMIN
  MODERATOR
}
enum UserTier {
  FREE
  STARTER
  PRO
  TEAM
  ENTERPRISE
}
enum IdeaStage {
  IDEA
  VALIDATION
  MVP
  LAUNCHED
}
enum IdeaStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
enum LeadStatus {
  NEW
  CONTACTED
  RESPONDED
  CONVERTED
  REJECTED
}
enum ValidationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
enum IndustryType {
  SaaS
  D2C
  Local_Service @map("Local Service")
}
enum PricingModelType {
  One_time     @map("One-time")
  Subscription
  High_Ticket  @map("High-Ticket")
}
enum UnlockedTier {
  STARTER
  PRO
}
enum TicketCategory {
  BILLING
  GENERATION
  ACCESS
  OTHER
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}
enum LegalDocType {
  TERMS
  PRIVACY
  REFUND
}
enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}
enum PayoutStatus {
  PENDING
  PAID
}
